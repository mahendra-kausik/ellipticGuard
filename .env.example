# .env.example — EllipticGuard
# Copy this file to .env, fill in your real values, and NEVER commit .env.
# .env is git-ignored. Only this file (.env.example) is committed.

# ── Layer 0: DVC / Google Drive remote ────────────────────────────────────────
# The folder ID from your Google Drive URL:
#   https://drive.google.com/drive/folders/<GDRIVE_FOLDER_ID>
# DVC uses this to push/pull versioned data and model artifacts.
GDRIVE_FOLDER_ID=

# ── Layer 0: MLflow ────────────────────────────────────────────────────────────
# Where MLflow logs runs. Defaults to a local ./mlruns directory if left empty.
# Leave empty for local tracking (recommended for free tier).
# Set to a remote URI (e.g., a Databricks or hosted MLflow server) only if you
# have one — do not sign up for paid services.
MLFLOW_TRACKING_URI=

# Experiment name used across all training runs.
MLFLOW_EXPERIMENT_NAME=elliptic-aml

# ── Layer 1: Data paths ────────────────────────────────────────────────────────
# Absolute or relative path to the directory containing the three raw CSVs:
#   elliptic_txs_features.csv
#   elliptic_txs_classes.csv
#   elliptic_txs_edgelist.csv
# Download from: https://www.kaggle.com/datasets/ellipticco/elliptic-data-set
RAW_DATA_DIR=data/raw

# ── Layer 7: Serving ───────────────────────────────────────────────────────────
# The name under which the champion model is registered in the MLflow registry.
# Must match the name used when registering during training (Layer 3+).
MLFLOW_REGISTERED_MODEL_NAME=elliptic-illicit

# ── Layer 11: Hugging Face Spaces deployment ───────────────────────────────────
# Your Hugging Face write-access token (hf.co → Settings → Access Tokens).
# Used only for deployment; NOT needed for local development or CI model runs.
HF_TOKEN=

# Your HF username and the Space name you created for this project.
HF_USERNAME=
HF_SPACE_NAME=elliptic-guard

# ── CI / GitHub Actions ────────────────────────────────────────────────────────
# These are set as GitHub Actions repository secrets, not in this file.
# Listed here for documentation only — do not fill them in:
#   GDRIVE_CREDENTIALS_DATA   (DVC Google Drive OAuth credentials JSON, base64-encoded)
#   HF_TOKEN                  (same as above — add as a GH secret for CD)
